# ===================================================
# FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Copy this to .env.local for local development or set in Vercel Dashboard
# ===================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Backend URL (Points to Render in production, localhost in development)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Customer Support & Order Notification Hotline
NEXT_PUBLIC_WHATSAPP_NUMBER=917985232434

# Payment Gateway (Public Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase PostgreSQL Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
