# ===================================================
# FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Copy this to .env.local for local development or set in Vercel & Render Dashboard
# ===================================================

# Node Environment ('development' or 'production')
NODE_ENV=production

# Backend URL (Points to Render in production, localhost in development)
NEXT_PUBLIC_API_URL=https://inveins-backend.onrender.com

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.inveins.in

# WhatsApp Customer Support & Order Notification Hotline
NEXT_PUBLIC_WHATSAPP_NUMBER=917985232434

# Payment Gateway (Cashfree Payments)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=TEST
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox

# Order Token & Admin Security Secrets
ORDER_SIGNING_SECRET=your_secure_order_signing_secret_hmac256
ADMIN_PIN=your_admin_portal_passcode_minimum_12_chars
ADMIN_SESSION_SECRET=your_admin_session_hmac_secret_64_hex_chars

# Supabase PostgreSQL Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://jpbotzytaekgvewyxljl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_bypasses_rls

# Cloudinary CDN Photo Hosting (Required to prevent database payload bloat)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.jpbotzytaekgvewyxljl:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.jpbotzytaekgvewyxljl:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
